{
  "name": "schedulein",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "prebuild": "rimraf dist",
    "build": "cross-env NODE_OPTIONS='--max-old-space-size=4096' nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start:dev": "cross-env NODE_OPTIONS='--max-old-space-size=8192' nest start --watch",
    "start:dev:memory": "cross-env NODE_OPTIONS='--max-old-space-size=4096' node --inspect ./node_modules/.bin/nest start --watch",
    "start": "cross-env NODE_OPTIONS='--max-old-space-size=4096' nest start",
    "start:debug": "cross-env NODE_OPTIONS='--max-old-space-size=4096' nest start --debug --watch",
    "start:prod": "cross-env NODE_OPTIONS='--max-old-space-size=4096' node dist/main",
    "start:docker": "cross-env NODE_ENV=production NODE_OPTIONS='--max-old-space-size=4096' node dist/main.js",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "docker:build": "docker build -t my-nestjs-app .",
    "docker:run": "docker run -p 3000:3000 --env-file .env my-nestjs-app",
    "docker:build:prod": "docker build -t my-nestjs-app:prod --target production .",
    "postinstall": "npm rebuild bcrypt --build-from-source"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.824.0",
